# Erasing, inserting, and deleting.

=== EL 0 erases from the cursor to the end of the line
size 10x1
input "abcdefghij\e[5G\e[K"
screen
  |abcd      |
cursor 5,1
ref ctlseqs: CSI Ps K (EL)

=== EL 1 erases from the start of the line to the cursor, inclusive
size 10x1
input "abcdefghij\e[5G\e[1K"
screen
  |     fghij|
cursor 5,1
ref ctlseqs: EL

=== EL 2 erases the whole line
size 10x1
input "abcdefghij\e[5G\e[2K"
screen
  |          |
cursor 5,1
ref ctlseqs: EL

=== ED 0 erases from the cursor to the end of the screen
size 5x3
input "aaa\r\nbbb\r\nccc\e[2;2H\e[J"
screen
  |aaa  |
  |b    |
  |     |
cursor 2,2
ref ctlseqs: CSI Ps J (ED)

=== ED 1 erases from the start of the screen to the cursor, inclusive
size 5x3
input "aaa\r\nbbb\r\nccc\e[2;2H\e[1J"
screen
  |     |
  |  b  |
  |ccc  |
cursor 2,2
ref ctlseqs: ED

=== ED 2 erases the whole screen without moving the cursor
size 5x3
input "aaa\r\nbbb\r\nccc\e[2;2H\e[2J"
screen
  |     |
  |     |
  |     |
cursor 2,2
ref ctlseqs: ED

=== ECH erases characters without shifting
size 10x1
input "abcdef\e[2G\e[2X"
screen
  |a  def    |
cursor 2,1
ref ctlseqs: CSI Ps X (ECH)

=== DCH deletes characters and shifts the rest left
size 10x1
input "abcdef\e[2G\e[2P"
screen
  |adef      |
cursor 2,1
ref ctlseqs: CSI Ps P (DCH)

=== ICH inserts blanks and shifts the rest right
size 10x1
input "abcdef\e[2G\e[2@"
screen
  |a  bcdef  |
cursor 2,1
ref ctlseqs: CSI Ps @ (ICH)

=== IL inserts lines and pushes the bottom lines out
size 5x3
input "aaa\r\nbbb\r\nccc\e[2;1H\e[L"
screen
  |aaa  |
  |     |
  |bbb  |
cursor 1,2
ref ctlseqs: CSI Ps L (IL)

=== DL deletes lines and pulls the lines below up
size 5x3
input "aaa\r\nbbb\r\nccc\e[2;1H\e[M"
screen
  |aaa  |
  |ccc  |
  |     |
cursor 1,2
ref ctlseqs: CSI Ps M (DL)

=== IL resets the cursor column to the first column
size 6x3
input "111111\r\n222222\e[2;4H\e[LX"
screen
  |111111|
  |X     |
  |222222|
cursor 2,2
ref DEC STD 070 (IL moves to column 1; xterm matches, ECMA-48 8.3.67 and alacritty_terminal keep the column)

=== DL resets the cursor column to the first column
size 6x3
input "111111\r\n222222\r\n333333\e[2;4H\e[MX"
screen
  |111111|
  |X33333|
  |      |
cursor 2,2
ref DEC STD 070 (DL moves to column 1; xterm matches, ECMA-48 8.3.32 and alacritty_terminal keep the column)

=== EL 0, 1, and 2 cancel a pending wrap
size 6x3
input "abcdef\e[0KX\r\nabcdef\e[1KY\r\nabcdef\e[2KZ"
screen
  |abcdeX|
  |     Y|
  |     Z|
cursor 6,3
ref ctlseqs: CSI Ps K (EL); xterm and tmux cancel pending wrap on EL 0, 1, and 2

=== ED 0, 1, and 2 cancel a pending wrap while ED 3 keeps it
size 6x2
input "abcdef\e[0JX\e[1;1Habcdef\e[3JY"
screen
  |abcdef|
  |Y     |
cursor 2,2
ref ctlseqs: CSI Ps J (ED); xterm and tmux cancel pending wrap on ED 0, 1, and 2, and keep it on ED 3

=== ICH, DCH, and ECH cancel a pending wrap
size 6x3
input "abcdef\e[1@X\r\nabcdef\e[1PY\r\nabcdef\e[1XZ"
screen
  |abcdeX|
  |abcdeY|
  |abcdeZ|
cursor 6,3
ref ctlseqs: CSI Ps @ (ICH), CSI Ps P (DCH), CSI Ps X (ECH)
